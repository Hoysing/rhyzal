{
  "name": "rhyzal",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "description": "Cron-powered GUI for Windows Task Scheduler, focused on the tasks you created",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hoysing/rhyzal.git"
  },
  "homepage": "https://github.com/Hoysing/rhyzal",
  "bugs": {
    "url": "https://github.com/Hoysing/rhyzal/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run test:unit && npm run test:rust && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:unit": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@svar-ui/svelte-grid": "^2.7.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.14.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "windows",
    "task-scheduler",
    "scheduled-tasks",
    "cron",
    "crontab",
    "gui",
    "tauri",
    "svelte",
    "rust",
    "sysadmin"
  ],
  "author": {
    "name": "Hoysing",
    "url": "https://github.com/Hoysing"
  }
}
