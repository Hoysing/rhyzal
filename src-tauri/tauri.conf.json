{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rhyzal",
  "version": "0.0.1",
  "identifier": "hoysing.rhyzal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1424",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rhyzal",
        "width": 1240,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDMTQyQjAyQzQwNDkyREEKUldUYWtnVEVBaXNVYk0yQ0IzVi9kMFVzWld2ZkY5dld1NGFaY2kxVjdhT3NXdHF4UUpPZ0szZloK",
      "endpoints": [
        "https://github.com/Hoysing/rhyzal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
